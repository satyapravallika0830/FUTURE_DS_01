# Triveni First Sales Graph 💪
import pandas as pd
import matplotlib.pyplot as plt

# Step 1: File ni load cheyyi
df = pd.read_csv('../datasets/superstore_sales.csv')

# Step 2: Category wise Sales leka
sales_by_category = df.groupby('Category')['Sales'].sum()

# Step 3: Graph geyy
plt.figure(figsize=(8,5))
sales_by_category.plot(kind='bar', color=['#FF6B6B', '#4ECDC4', '#45B7D1'])

plt.title('Triveni Sales Analysis - Day 1', fontsize=14, fontweight='bold')
plt.xlabel('Product Category', fontsize=12)
plt.ylabel('Total Sales Amount', fontsize=12)
plt.xticks(rotation=0)
plt.grid(axis='y', linestyle='--', alpha=0.7)
plt.tight_layout()
plt.show()

print("✅ Graph Success Triveni! First task complete!")
